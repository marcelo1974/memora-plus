{
  "name": "memora-plus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdf-fonts.mjs && node --import tsx server.ts",
    "build": "node scripts/copy-pdf-fonts.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --import ./scripts/production-env.mjs dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:server": "node tests/server-smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:server"
  },
  "dependencies": {
    "@google/genai": "2.25.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "firebase": "12.19.0",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-typescript": "7.28.5",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
